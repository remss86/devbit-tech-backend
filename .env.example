# Local development defaults. Generate a unique secret before any production/release run.
NODE_ENV=development
BIND_ADDR=127.0.0.1:7878
DATABASE_URL=postgres://postgres:@localhost:5432/users
JWT_SECRET=devbit-local-secret

# SMTP may be unset only when development-code exposure is allowed: explicit
# NODE_ENV=development/test, or an unset NODE_ENV in a debug build.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# Optional tracing filter, for example: devbit=debug,tower_http=info
RUST_LOG=info

# Frontend API path. Keep this as /api so local development matches production.
NUXT_PUBLIC_API_BASE=/api

# Rust backend origin used by Nuxt route rules when /api is handled by Nuxt.
NUXT_API_PROXY_TARGET=http://127.0.0.1:7878

# legacy: existing contacts; v2: new contract; mock: local development only.
NUXT_PUBLIC_SOCIAL_MODE=v2
NUXT_PUBLIC_SOCIAL_BLOCKS_ENABLED=true
NUXT_PUBLIC_SOCIAL_PREFERENCES_ENABLED=true
NUXT_PUBLIC_SOCIAL_PRESENCE_ENABLED=true
NUXT_PUBLIC_SOCIAL_HISTORY_ENABLED=true
# Workspace extensions: enable only after the backend contract is implemented.
NUXT_PUBLIC_SOCIAL_DIRECTORY_ENABLED=false
NUXT_PUBLIC_SOCIAL_PROFILES_ENABLED=true
NUXT_PUBLIC_SOCIAL_METADATA_ENABLED=false
NUXT_PUBLIC_SOCIAL_GROUPS_ENABLED=false
NUXT_PUBLIC_SOCIAL_CONVERSATIONS_ENABLED=false
NUXT_PUBLIC_SOCIAL_RECEIPTS_ENABLED=false
# Development mock fixture: standard | large (57 friends and a long name).
NUXT_PUBLIC_SOCIAL_DEMO_SCENARIO=standard
# disabled | v2 | mock (development only)
NUXT_PUBLIC_ACCOUNT_RECOVERY_MODE=disabled