# Local development defaults. Generate a unique secret before any production/release run.
NODE_ENV=development
BIND_ADDR=127.0.0.1:7878
DATABASE_URL=postgres://postgres:@localhost:5432/users
JWT_SECRET=devbit-local-secret

# SMTP may be unset only when development-code exposure is allowed: explicit
# NODE_ENV=development/test, or an unset NODE_ENV in a debug build.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# Optional tracing filter, for example: devbit=debug,tower_http=info
RUST_LOG=info
